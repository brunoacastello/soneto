{
  "name": "soneto",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/p/*", "/a/*", "/sitemap.xml"]
  },
  "observability": { "enabled": true }
}
